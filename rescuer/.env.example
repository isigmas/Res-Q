# Res-Q Rescuer App - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# WebSocket Configuration (Required)
# ============================================
# WebSocket URL for real-time victim location tracking
# Development: ws://localhost:3000
# Production: wss://your-production-server.com
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# ============================================
# Backend API Configuration (Optional)
# ============================================
# HTTP API URL for REST endpoints (if needed)
# Development: http://localhost:3000
# Production: https://your-production-server.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# ============================================
# Authentication (Optional)
# ============================================
# API authentication token or key (if required by backend)
# EXPO_PUBLIC_API_KEY=your-api-key-here
# EXPO_PUBLIC_AUTH_TOKEN=your-auth-token-here

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable features during development
# EXPO_PUBLIC_ENABLE_SATELLITE_MODE=false
# EXPO_PUBLIC_ENABLE_DEBUG_MODE=true

# ============================================
# Map Configuration (Optional)
# ============================================
# If using map services (Google Maps, Mapbox, etc.)
# EXPO_PUBLIC_MAPS_API_KEY=your-maps-api-key-here

# ============================================
# Notes
# ============================================
# - Variables prefixed with EXPO_PUBLIC_ are available in your app code
# - Never commit .env file with real credentials to git
# - .env is already in .gitignore
# - Restart the Expo dev server after changing environment variables
